{
  "name": "royal-mobile",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test -w server",
    "create-admin": "npm run create-admin -w server",
    "migrate:neon": "npm run migrate:neon -w server",
    "test:integration": "node server/test/integration.mjs",
    "format": "prettier --write client/src server/*.js server/test/*"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.25.12": true
  }
}
