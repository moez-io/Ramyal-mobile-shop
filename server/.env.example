# Leave DATABASE_URL empty to use the local SQLite database.
SQLITE_PATH=./data/royal_mobile.sqlite
# For Neon/Vercel, set DATABASE_URL to the Neon pooled connection string.
DATABASE_URL=
# Keep the Vercel Blob token private. Required on Vercel for photo uploads.
BLOB_READ_WRITE_TOKEN=
# Optional: set to a custom hostname if using a custom Vercel Blob domain.
BLOB_HOSTNAME=
JWT_SECRET=generate-a-private-random-secret-of-at-least-32-characters
PORT=4000
NODE_ENV=development
SHOP_NAME=Royal Mobile House
